{
  "info": {
    "name": "EduLink LMS API",
    "description": "Complete API collection for the EduLink Learning Management System. Set the `base_url` and `token` collection variables before running requests.\n\nAuth flow:\n1. Run **Login** under the Users folder\n2. The `token` variable is set automatically via the test script\n3. All subsequent requests use Bearer {{token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string",
      "description": "Change to your deployed API base URL"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Populated automatically by the Login request test script"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string",
      "description": "Populated automatically by the Login request test script"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Users",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "    pm.test('Login successful – token saved', () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"student\",\n  \"school_id\": \"SCI-2024-001\",\n  \"password\": \"secret\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/login/",
              "host": ["{{base_url}}"],
              "path": ["users", "login", ""]
            },
            "description": "Authenticate and receive JWT tokens. The test script saves `access_token` into the `token` collection variable automatically.\n\nRole must be one of: `student`, `teacher`, `principal`, `admin`."
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/me/",
              "host": ["{{base_url}}"],
              "path": ["users", "me", ""]
            },
            "description": "Returns the authenticated user's profile. Response is cached server-side."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{base_url}}/users/logout/",
              "host": ["{{base_url}}"],
              "path": ["users", "logout", ""]
            },
            "description": "Invalidates the cached login token for the current user."
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/",
              "host": ["{{base_url}}"],
              "path": ["users", ""]
            },
            "description": "Admin/staff see all users. Other roles see only their own record."
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_id\": \"SCI-2024-099\",\n  \"role\": \"student\",\n  \"email\": \"newstudent@school.edu\",\n  \"first_name\": \"Ama\",\n  \"last_name\": \"Serwaa\",\n  \"password\": \"changeme123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/",
              "host": ["{{base_url}}"],
              "path": ["users", ""]
            },
            "description": "Admin only."
          }
        },
        {
          "name": "Retrieve User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/1/",
              "host": ["{{base_url}}"],
              "path": ["users", "1", ""]
            }
          }
        },
        {
          "name": "Update User (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_id\": \"SCI-2024-001\",\n  \"role\": \"student\",\n  \"email\": \"updated@school.edu\",\n  \"first_name\": \"Kwame\",\n  \"last_name\": \"Asare\",\n  \"password\": \"newpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/1/",
              "host": ["{{base_url}}"],
              "path": ["users", "1", ""]
            },
            "description": "Admin only. Full update."
          }
        },
        {
          "name": "Update User (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patched@school.edu\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/1/",
              "host": ["{{base_url}}"],
              "path": ["users", "1", ""]
            },
            "description": "Admin only. Partial update."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/users/1/",
              "host": ["{{base_url}}"],
              "path": ["users", "1", ""]
            },
            "description": "Admin only."
          }
        }
      ]
    },
